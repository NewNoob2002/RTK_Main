menu "RTK_main"

    choice RTK_BOARD
        prompt "Board profile"
        default RTK_BOARD_AUTO

        config RTK_BOARD_AUTO
            bool "Identify using GPIO35"

        config RTK_BOARD_FORCE_E1_DEVKIT
            bool "Force E1 DevKit (bench only)"

        config RTK_BOARD_FORCE_P2_V141
            bool "Force P2 v1.41 (bench only)"
    endchoice

    choice RTK_LINK_POLICY
        prompt "SPP link policy"
        default RTK_LINK_POLICY_CONCURRENT
        help
            选择手机与报警器同时在线（CONCURRENT）或手机优先（PHONE_PREEMPT）。
            PHONE_PREEMPT 下手机接入会断开报警器，手机在线时拒绝新的报警器。

        config RTK_LINK_POLICY_CONCURRENT
            bool "CONCURRENT: phone and alarm online together"

        config RTK_LINK_POLICY_PHONE_PREEMPT
            bool "PHONE_PREEMPT: phone disconnects alarm"
    endchoice

    config RTK_LINK_RX_BUF_BYTES
        int "kLink per-session RX staging buffer size (bytes)"
        range 256 1024
        default 512
        help
            kLink 每会话从 spp_server 一次拉取并跨轮保留未消费尾字节的暂存缓冲大小。
            默认 512 B；可回退到 256 B 以观察对吞吐的影响。

    config RTK_TRACE_ENABLE
        bool "Enable runtime debug trace (trace ring, debug module and commands)"
        default y
        help
            ADR-0009 运行时追踪。关闭后：fw::trace()/trace_on() 编译为空内联（各组件调用点被优化掉），
            spp_server 不再调用追踪钩子，main 不编译 debug 模块（追踪环、trace_out 任务、debug 命令组、
            NVS "dbg" 键表）。调试阶段保持开启。

    config RTK_LOG_LEVEL
        int "Compile-time max component log level (0=E 1=W 2=I 3=D, ADR-0009 §2.12)"
        range 0 3
        default 3
        help
            fw/Log.hpp 的 FW_LOGE/W/I/D 编译期上限：高于它的调用连同参数求值一起编译掉。
            运行期 E/W 总是输出；I/D 还需 `debug on <类别>` 且不高于 `debug level`。
            关闭 RTK_TRACE_ENABLE 时 I/D 无法打开，上限自动按 W 处理。

    config RTK_LOG_RING_BYTES
        int "Text log ring size (bytes, ADR-0009 §2.11)"
        depends on RTK_TRACE_ENABLE
        range 1024 16384
        default 4096
        help
            fw::LogRing 的字节容量：变长记录环，容纳 fw::tlog()/tlog_hex() 写出的句子与原始字节。
            整条记录放不下就丢弃并计数（不做拆段），因此容量至少要能装下最长的一条
            （12 B 记录头 + 256 B 十六进制载荷）。fw/Log.hpp 的 FW_LOG* 也写入此环。静态存储，不占堆。

    config RTK_BOOT_VERBOSE
        bool "Print the boot step table after boot (R8a)"
        default n
        help
            启动成功后除了单行摘要，再打印 `sys boot` 的同一张步骤表（步骤、结果、耗时、堆水位、
            降级原因）。仅影响输出，不影响启动顺序或内存布局。

    config RTK_BOOT_FAULT_STEP
        string "Force a boot step to fail (HIL only, R8a)"
        default ""
        help
            仅用于台架验证启动降级路径：填步骤名（identify/power/banner/earlyConfig/radio/contexts/console/alloc/bind/seal/
            debug/storage/system/link/io/started）时该步不执行并返回失败，原因记为 ``fault:<step>``。
            留空即正常启动。不得在产品固件中填写。

    config RTK_STRICT_WARNINGS
        bool "Treat all warnings in project code as errors (debug phase)"
        default y
        help
            调试阶段默认开启：本工程组件、main 与 test_apps 的所有编译告警都按错误处理，
            包括 IDF 默认降级为告警的 unused-*/deprecated-declarations/extra，
            以及 IDF 默认关闭的 unused-parameter、sign-compare（见 cmake/strict_warnings.cmake）。
            只影响本工程代码，不影响 IDF 自身组件。

    choice RTK_CONSOLE_PROFILE
        prompt "Console build profile"
        default RTK_CONSOLE_PROFILE_DEV
        help
            ADR-0016 控制台构建档位，在编译时选择。
            DEV 保留完整开发控制台（默认）。
            PRODUCTION 保留诊断、隐藏的 factory 工厂配置和 freset。
            NONE 只保留串口日志，不启动 REPL。

        config RTK_CONSOLE_PROFILE_DEV
            bool "DEV: development console"

        config RTK_CONSOLE_PROFILE_PRODUCTION
            bool "PRODUCTION: diagnostics and factory console"

        config RTK_CONSOLE_PROFILE_NONE
            bool "NONE: UART logging only"
    endchoice

    config RTK_FACTORY_KEY
        string "Factory console unlock key"
        default "rtk-factory"
        help
            Key for the hidden `factory unlock <key>` console command (ADR-0009 §2.10).
            Factory commands write production settings (SN, alarm whitelist) or force
            alarm state; keep the key out of customer documentation.

    config RTK_WIFI_CONFIG_ENABLE
        bool "Enable Wi-Fi configuration radio mode (ADR-0017)"
        default y
        help
            Allow selecting Wi-Fi configuration mode at the next software restart.
            Disable to boot in Bluetooth mode and omit the radio console command.

    menu "GNSS (ADR-0010)"

        config RTK_GNSS_ENABLE
            bool "Enable GNSS module (UART, probe/config, RTCM input pipe)"
            default y
            help
                关闭则不编译 gnss 模块、kIo 执行器与 RTCM 输入管道；rtcm 模块只做统计。

        config RTK_GNSS_UART_NUM
            int "UART port connected to GNSS module"
            depends on RTK_GNSS_ENABLE
            range 1 2
            default 2

        config RTK_GNSS_DEFAULT_BAUD
            int "Default module baud rate (first probe, no NVS record)"
            depends on RTK_GNSS_ENABLE
            range 9600 921600
            default 115200

        config RTK_GNSS_TARGET_BAUD
            int "Target runtime module baud rate after probe (no user NVS override)"
            depends on RTK_GNSS_ENABLE
            range 9600 921600
            default 460800
            help
                探测成功后的默认运行波特率（仅修改运行态，不发送 SAVECONFIG）。
                须取 validUserBaud 支持的标准速率（9600/19200/38400/57600/115200/230400/460800/921600）；
                用户经 gnss baud <n> 写入 NVS gnss/baud（非 0）时优先使用用户值。

        config RTK_GNSS_PORT
            int "E1 bench receiver port wired to ESP32 (UM980 COM2 = 2)"
            depends on RTK_GNSS_ENABLE
            range 1 3
            default 2

        config RTK_GNSS_RATE_HZ
            int "Default fix rate in Hz (1/2/5/10/20)"
            depends on RTK_GNSS_ENABLE
            range 1 20
            default 1

        config RTK_GNSS_APP_RING_BYTES
            int "GNSS App typed ring size (bytes, ADR-0011)"
            depends on RTK_GNSS_ENABLE
            range 1024 16384
            default 4096
            help
                fw::FanoutRing（typed 模式）静态环形缓冲大小；记录头 3 B，最大单条载荷为容量减 3 B。

        config RTK_GNSS_STATIC_OBS_ENABLE
            bool "Reserve static GNSS observation path (K6 placeholder)"
            depends on RTK_GNSS_ENABLE
            default n
            help
                K4 仅作配置占位（固定关闭），不分配 obs 观测环，不创建 SD/SPI/文件任务。

    endmenu

endmenu
