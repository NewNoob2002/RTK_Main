# RTK_main 默认配置（冻结输入）。来源：E1-5.4/sdkconfig 中已在硬件上验证的项 + IDF v6.1 bt_spp_acceptor 示例。
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_3_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 崩溃转储（ADR-0014 §2.1）：格式和校验沿用 ESP-IDF 缺省。
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_TASK_WDT_EN=y

# 经典蓝牙 SPP，仅 BR/EDR（与 5.4 一致；BLE 关闭以省 RAM）
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y

# ADR-0017：Wi-Fi 网页配置模式（与蓝牙按启动互斥，不同时运行，故不开软件共存）。
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# H1c Wi-Fi/lwIP 内存档（依据 ESP-IDF v6.1.1 api-guides/wifi-driver/wifi-performance-and-power-save.html
# “How to Configure Parameters”表的 Memory saving 档：TCP 吞吐约 30 Mbit/s，远高于配置页约 1 KB/s 的需求）。
# 静态 RX 缓冲在 esp_wifi_init() 时从堆分配，10→6 省 6400 B；手册要求开启 AMPDU 时不得低于 6。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# 动态 RX/TX 缓冲只限制峰值；手册 Memory saving 档取 12。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
# RX_BA_WIN 保持 6（= Memory saving 档，且 ≤ min(2×静态 RX, 动态 RX)）。
# TCP 发送缓冲和接收窗口沿用默认 5760 B，已小于该档的 12 KB。
# SoftAP 只用 WPA2-PSK，不需要 SAE/OWE 代码与运行期内存。
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP=n
# 固件只用 IPv4（SoftAP 192.168.x）；手册 lwip.html：关 IPv6 省启动 2 KB、协议栈运行时 7 KB RAM。
CONFIG_LWIP_IPV6=n
# lwip.html 建议按需减少 socket；httpd 要求 LWIP_MAX_SOCKETS >= max_open_sockets(3) + 3，取 8 留 2 个余量。
CONFIG_LWIP_MAX_SOCKETS=8
# Wi-Fi/lwIP IRAM 优化保持开启（手册各档均开启）；管理帧缓冲与 TCP/IP 邮箱保持默认。

# 控制台串口（ADR-0009 §2.4）：2 Mbaud + 8 KB TX 环形缓冲，长输出不阻塞命令任务。
# ESP_CONSOLE_UART_BAUDRATE 只在 CUSTOM 变体下可写（esp_stdio/Kconfig:150 的 prompt 条件），
# 因此这里用 CUSTOM + UART0 + ESP32 默认引脚 1/3；波特率必须与 RTK 的一致，否则输出乱码。
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_RTK_CONSOLE_UART_BAUD=2000000
CONFIG_RTK_CONSOLE_UART_TX_BUF=8192

# 性能（2026-11-12 用户批准，T3 实测后调整）：芯片额定 240 MHz；Fudan 8 MB flash 支持 80 MHz QIO；
# app 槽 3 MB（ADR-0014 §2.1），-O2 镜像仍有充足余量。QIO 若在某批板子上启动失败，退回 DIO（保留 80 MHz）。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# C++（ADR-0002，T2）：与 IDF v6.1 默认值一致，显式写出以免被改动（CPP-001/002）
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# 蓝牙 HCI 日志只保留错误：手机频繁切换 sniff/active 时 Bluedroid 以 WARNING 打印每次 mode change，刷屏且无诊断价值（2026-11-19 P2 HIL）
CONFIG_BT_LOG_HCI_TRACE_LEVEL_ERROR=y
